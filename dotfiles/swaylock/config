daemonize
ignore-empty-password
font=Rubik
font-size=23

clock
timestr=%H:%M
datestr=%A, %e de %B 

screenshots
effect-blur=15x3
fade-in=0.2 

# Nota: Si prefieres usar una imagen de fondo fija en lugar del desenfoque, 
# borra la línea "screenshots" y usa:
# image=/ruta/absoluta/a/tu/wallpaper.jpg

indicator
indicator-radius=80
indicator-thickness=7 
indicator-caps-lock

key-hl-color=d4d4d4
caps-lock-key-hl-color=d4d4d4

separator-color=00000000

inside-color=00000044
inside-clear-color=00000044
inside-caps-lock-color=00000044
inside-ver-color=00000044
inside-wrong-color=00000044

ring-color=ffffff44
ring-clear-color=ffffff44
ring-caps-lock-color=ffffff44
ring-ver-color=00aaff88 
ring-wrong-color=ee2e2488

line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

text-color=ffffff
text-clear-color=ffffff
text-ver-color=ffffff
text-wrong-color=ee2e24

bs-hl-color=470400
caps-lock-bs-hl-color=470400
text-caps-lock-color=d4d4d4
